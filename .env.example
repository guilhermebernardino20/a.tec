# Envio do formulário de contato (Resend)
# Sem RESEND_API_KEY o site continua funcionando: a solicitação é
# validada e registrada no log do servidor, sem disparar e-mail.
RESEND_API_KEY=

# Caixa que recebe os leads
CONTACT_DESTINATION_EMAIL=contato@chomabettegaadvocacia.com.br

# Remetente. Enquanto o domínio não estiver verificado no Resend, use o
# sandbox `onboarding@resend.dev` — que só entrega para o e-mail dono da
# conta. Com DKIM/SPF publicados, troque por algo como:
#   A.TEC <contato@atec.com.br>
CONTACT_FROM_EMAIL=A.TEC Site <onboarding@resend.dev>
